# Firebase Client Configuration (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="andaoku-edu.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="andaoku-edu"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="andaoku-edu.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional Firebase Emulator Host (for local testing)
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR="true"
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="localhost:8080"
# NEXT_PUBLIC_AUTH_EMULATOR_HOST="localhost:9099"

# Optional Firebase Admin SDK (Server-side privileged operations)
# FIREBASE_PROJECT_ID="andaoku-edu"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@andaoku-edu.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"
