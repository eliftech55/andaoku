# Firebase Client Configuration (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"

# Server-side Google Gemini API key (never expose with NEXT_PUBLIC_)
GEMINI_API_KEY="your-gemini-api-key"

# Optional Firebase Emulator Host (for local testing)
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR="true"
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="localhost:8080"
# NEXT_PUBLIC_AUTH_EMULATOR_HOST="localhost:9099"

# Optional Firebase Admin SDK (Server-side privileged operations)
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"
